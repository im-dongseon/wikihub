[Unit]
Description=WikiHub lint — 위키 일관성 검사 (ADR-0008)
After=network-online.target
Wants=network-online.target
OnFailure=ops-alert.service

[Service]
Type=oneshot
WorkingDirectory={wikihub_home}
# R10 CRIT-2: instance.root 미존재 시 자가 복구 — yaml 편집 후 setup 미호출 케이스 안전망.
ExecStartPre=/bin/mkdir -p {wikihub_home}
Environment=PATH={venv_path}/bin:/usr/local/bin:/usr/bin:/bin
Environment=WIKIHUB_YAML={wikihub_home}/wikihub.yaml
# ADR-0036 — graphify Pass 3 (LLM subagent) 의 API key. lenient `-` prefix:
#   파일 부재 또는 빈 값이어도 unit start 자체는 성공 — graphify subprocess 만 fail.
#   운영자가 ~/.config/wikihub/env 에 ANTHROPIC_API_KEY=... 채움 (chmod 600, install.sh 가 보장).
EnvironmentFile=-%h/.config/wikihub/env
ExecStart={agent_invocation_for_wh_lint} "/wh-lint"
SuccessExitStatus=0 75
TimeoutStartSec={timeout_start_sec}sec
SyslogIdentifier=wikihub-lint

# Restart= 미설정 (F1 §4.8.2 정합) — oneshot 의 재시도는 timer 책임.
# [Install] 미작성 — timer 가 service 를 trigger.
