[Unit]
Description=WikiHub pending_ingest age monitor (ADR-0037 §D2)
After=network-online.target
Wants=network-online.target
# NOTE: OnFailure 미설정 — pending_monitor.py 가 항상 exit 0 + ops-alert 호출은 본 service 내부 책임.
#       외부 OnFailure recursion 회피 (ADR-0037 §D2 정합).

[Service]
Type=oneshot
WorkingDirectory={wikihub_home}
ExecStartPre=/bin/mkdir -p {wikihub_home}
Environment=PATH={venv_path}/bin:/usr/local/bin:/usr/bin:/bin
Environment=WIKIHUB_YAML={wikihub_home}/wikihub.yaml
ExecStart={venv_path}/bin/python {wikihub_src}/scripts/pending_monitor.py
SuccessExitStatus=0
TimeoutStartSec=60sec
SyslogIdentifier=wikihub-pending-monitor

# pending_monitor.py 가 vault 별 _state/<id>/pending_ingest.json age 검사 →
# threshold 위반 시 last_failure.json 갱신 + systemctl --user start ops-alert.service 호출.
# 본 service 자체는 systemd OnFailure recursion 회피 — 항상 exit 0.
