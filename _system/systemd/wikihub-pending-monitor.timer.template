[Unit]
Description=WikiHub pending_ingest age monitor timer (ADR-0037 §D2)

# OnBootSec=10min: reboot 후 mount/vault timer 가 settle 된 후 fire
# OnActiveSec=10min: timer restart on running system 시점 기준 (install.sh --update 후 OnBootSec 가 과거인 시나리오 가드, ADR-0030 정합)
# OnUnitInactiveSec=30min: 직전 service inactive 후 30분 — pending 검사 주기
# !! systemd unit syntax — trailing inline comment 미지원 (V<N> 결함 #5, 2026-05-17)
[Timer]
Unit=wikihub-pending-monitor.service
OnBootSec=10min
OnActiveSec=10min
OnUnitInactiveSec=30min
AccuracySec=5min

[Install]
WantedBy=timers.target
