[Unit]
Description=WikiHub rclone mount — %i
After={after_target}
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=ops-alert.service

[Service]
Type=simple
WorkingDirectory={wikihub_home}
Environment=PATH={venv_path}/bin:/usr/local/bin:/usr/bin:/bin
Environment=RCLONE_CONFIG={rclone_config_path}
ExecStartPre=-/bin/fusermount3 -uz {wikihub_home}/vault/%i
ExecStartPre=/bin/mkdir -p {wikihub_home}/vault/%i
ExecStartPre=-{rclone_bin} mkdir {remote_name_for_%i}:{remote_path_for_%i}
{tcp_check_pre}
ExecStart={rclone_bin} mount {remote_name_for_%i}:{remote_path_for_%i} {wikihub_home}/vault/%i \
  {mount_options}
ExecStop=/bin/fusermount3 -u {wikihub_home}/vault/%i
Restart={restart_policy}
RestartSec=10s
RemainAfterExit=no
SyslogIdentifier=wikihub-mount-%i

# {template_comments}

[Install]
WantedBy=default.target
