[Unit]
Description=WikiHub Hermes-independent fatal alert dispatcher (ADR-0024)
# R10 CRIT-1 fix: StartLimit* 추가 — venv 손상 / ImportError / WorkingDirectory 부재 등으로
# ops-alert.service 자체가 fail 시 OnFailure recursion 가능성 차단.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=no
WorkingDirectory={wikihub_home}
# R10 CRIT-2: instance.root 미존재 시 자가 복구. ops-alert 자체가 final dispatcher 이므로
# ExecStartPre 실패는 StartLimitBurst 로 차단 (OnFailure recursion 회피).
ExecStartPre=/bin/mkdir -p {wikihub_home}
Environment=PATH={venv_path}/bin:/usr/local/bin:/usr/bin:/bin
Environment=WIKIHUB_YAML={wikihub_home}/wikihub.yaml
# ADR-0037 §D1 (v0.1.5) — Telegram alert channel env. lenient `-` prefix: 파일 부재/빈 값 OK.
# 운영자가 ~/.config/wikihub/env 에 TELEGRAM_ALERT_BOT_TOKEN + TELEGRAM_ALERT_CHAT_ID 채움.
EnvironmentFile=-%h/.config/wikihub/env
ExecStart={venv_path}/bin/python {wikihub_src}/scripts/ops-alert.py
# R16-M1 (V<N> R16 SRE 리뷰): 30s → 180s. ops-alert.py 의 collect_mount_fallback_failures
# 가 vault 마다 systemctl is-failed (5s) + journalctl -u (10s) 호출 — N vault 시 최악 N*15s.
# 5 vault 시 75s 가능 → 30s timeout 초과 → StartLimitBurst 카운트 소진 시 silent. 180s 면
# 12 vault 까지 안전 (12*15=180s 가까이 — 운영 v0.1.0 단일 vault 가정에선 여유).
TimeoutStartSec=180s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wikihub-ops-alert

# 트리거: 각 vault ingest service 의 OnFailure=ops-alert.service.
# 단독 활성화 안 함 — [Install] 없음. systemd 의 OnFailure 경로로만 호출.
# ops-alert.py 는 항상 exit 0 — 본 service 자체 실패가 OnFailure recursion 일으키지 않음.
# 추가 안전: StartLimitBurst=3 / 5분 — 5분 안에 3회 fail 시 systemd 가 더 이상 trigger 안 함.
#
# !!! 절대 OnFailure= 를 본 service 에 추가하지 말 것 (R10 CRIT-1) !!!
# ops-alert.service 가 venv 손상/ImportError/CHDIR 등으로 systemd 측 fail 분류 시,
# OnFailure 가 자기 자신을 trigger → fatal loop 가능. 본 service 는 final dispatcher 로 격리.
# RemainAfterExit=no — Type=oneshot 의 idle 상태가 active(success) 로 보존되어 OnFailure 가 미발화되는 의미론적 함정 차단.
