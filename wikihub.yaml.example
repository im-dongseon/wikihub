# WikiHub 운영 정본 (wikihub.yaml) 의 read-only template — ADR-0031.
# `/wh-setup` 첫 호출이 본 파일을 read → derived 필드 patching → $WIKIHUB_HOME/wikihub.yaml 에 atomic write.
# install.sh 는 yaml 미관여 (ADR-0031 §Decision A — Partially supersedes ADR-0010).
# 이후 메인테이너가 operational yaml 에서 vault 정의·rclone_remote_name 등 채운 후 /wh-setup --enable 재호출.
#
# 본 파일은 v0.1.0 schema v1 정합 (ADR-0031·ADR-0034·ADR-0035).
# v0.1.0 layout (ADR-0034): ~/wikihub/ = 운영 자산 (WIKIHUB_HOME), ~/.local/share/wikihub/src/ = 시스템 코드 (WIKIHUB_SRC).
# ADR-0035: gws CLI 폐기 + SA 폐기. rclone OAuth 단일 인증 — credentials_path/bootstrap_allowed/gws_min_version 키 모두 폐기.

version: 1

instance:
  root: ~/wikihub                     # ADR-0034: WIKIHUB_HOME 의미 = 운영 자산 dir (data-first)
  timezone: Asia/Seoul

vaults:
  - id: gdrive
    type: gdrive_api
    enabled: false             # 운영 시작 시 true 로 변경
    sync_interval_sec: 3600    # 1h (v0.1.6 default 600 → 3600 — mechanical phase IO·log.md noise 절감, 260520 §V 운영 결정 align). has_changes=false 경로의 LLM cost 는 0 이지만 lsjson + log append cycle 빈도 6배 감소. 변경 detect 지연 (~1h) 트레이드오프 → 더 짧게 원하면 600 으로 override.
    local_path: ~/wikihub/vault/gdrive             # rclone mount 가 마운트하는 path (= mount_path 정합, ADR-0025)
    options:
      # ADR-0035: credentials_path / root_folder_id 폐기. rclone.conf 가 단일 인증 자료 (~/.config/rclone/rclone.conf).
      # mount root 자체가 trust boundary — sub-path (rclone_remote_path) 로 scope 좁힘.
      exclude_shared_with_me: true    # sharedWithMe 파일 제외 (trust boundary). rclone lsjson default 가 정합
      max_file_size_mb: 50            # 큰 파일 skip threshold
      false_delete_threshold: 0.3     # ADR-0035 §ζ2 — 한 사이클의 삭제 비율 임계치. 초과 시 Retryable (mount/auth 부분 장애 가드)
      # ADR-0025·0026·0035 — rclone mount + lsjson:
      mount_path: ~/wikihub/vault/gdrive            # local_path 와 동일 — rclone mount 가 마운트하는 path
      rclone_remote_name: gdrive                    # ~/.config/rclone/rclone.conf 의 remote 이름 (rclone.conf section 명, OAuth provider 식별)
      rclone_remote_path: wikihub                   # remote 내 sub-path (빈 문자열이면 remote 루트). mount + lsjson 공통 scope. mount 시 부재면 자동 mkdir
      rclone_rc_port: 5572                          # per-vault rclone rc port. 다중 vault 시 +1 순번

operations:
  lint_interval_hours: 3                # v0.1.5 default 24 → 3 — 더 빠른 wiki 위생 사이클. 단 graphify chain (graphify_enabled=true) 의 cost 가 8배 증가 — 부담 시 `graphify_enabled: false` toggle 권장.
  lint_contradiction_check: true      # v0.1.5 toggle — false 시 lint Step 6 (LLM 모순·stale·entity 누락 점검) skip. DeepSeek 등 느린 backend 의 cost/시간 통제.
  graphify_enabled: true              # v0.1.5 toggle — false 시 lint Step 9 의 graphify chain skip. 운영자 cost / API key 부재 대응. Step 3 의 wiki 순회 fallback 으로 lint 본체 정상 동작.
  max_concurrent_vaults: serial       # v0.1.0 단일 vault 가정 — F6 시점 재검토
  retry:
    max_attempts: 5
    backoff_base_sec: 60
  disk: {}                            # operations.disk.* 스키마는 F4 미정의 — v0.2.x
  fatal_webhook_url: null             # 미설정 시 ops-alert.service no-op (journal 만)
  fatal_webhook_timeout_sec: 10
  instance_label: null                # R10 MED-3 + R16-L6: webhook payload 의 wikihub_instance 식별자. 미설정 시 socket.gethostname() 사용 — OCI internal hostname (예: inst-2x4-arm-ubuntu) 외부 SaaS (Slack/Discord) leak 회피 위해 운영자 명시 alias 권장. 권장 형식: "wikihub-prod-ap1" / "wikihub-staging".
  # Issue #104 (v0.1.10) — systemd TimeoutStartSec yaml-driven. 미설정 시 agent.timeout_sec fallback → 600:
  lint_timeout_start_sec: 1200          # wikihub-lint.service TimeoutStartSec. lint Step 9 (graphify trigger) 는 fire-and-forget 이므로 lint timeout 과 graphify timeout 은 독립적.
  ingest_timeout_start_sec: 1200        # wikihub-ingest@.service TimeoutStartSec. vault size 대비 여유 margin 필요 시 증설.
  # lint_operations_improvements (v0.1.8) — graphify timeout yaml expose (ADR-0036 §"후속 영향" + ADR-0039 alias frontmatter):
  graphify_timeout_sec: 900                        # graphify subprocess wrapper timeout (15분). v0.1.5~v0.1.7 era hard-coded 720s 에서 yaml expose 격상. LLM backend latency 누적 대비 default 900s. 운영자 backend 별 조정 가능.
  graphify_partial_failure_threshold: 0.5          # graphify graph 의 N/M ratio threshold (Pass 3 silent partial failure 가드). N=graph 노드 수, M=wiki .md 페이지 수. 0.5 미만 시 _lint/report.md + journal 에 partial failure 의심 warn. 운영자 별 조정 가능 (작은 wiki 또는 entity stub 누적 적은 초기엔 보수적 default 가 false positive 가능 — 0.3 등으로 낮춤 권장). ADR-0036 §재검토 트리거.
  # ADR-0035: gws_min_version 폐기. rclone version 만 유지.
  # ADR-0025·0026 — rclone install + vfs cache 정책:
  rclone_min_version: "1.65.0"        # install.sh `_install_rclone` 의 min
  rclone_max_version: "1.99.99"       # ADR-0025 breaking change 방어
  vfs_cache_max_size: "10G"           # rclone mount `--vfs-cache-max-size`
  vfs_refresh_mode: recursive         # ADR-0026 K1 채택 (recursive | per-file | none — K2/K3 v0.2.x deferred)
  # ADR-0036 — graphify CLI (PyPI graphifyy):
  graphify_min_version: "0.8.0"       # install.sh `_install_graphify` 의 min (v0.1.0 documentation only — 실 enforce 는 v0.2.x)
  graphify_max_version: "0.99.99"     # ADR-0036 breaking change 방어
  graphify_backend: ollama            # graphify --backend = protocol (graphify CLI 의 코드 경로). v8 backends: gemini | kimi | claude | openai | deepseek | ollama. ADR-0036 §Note (2026-05-24, v0.1.7 follow-up) — `ollama` backend 는 endpoint 형식 자동 분기 (loopback → native OLLAMA_HOST API, 외부 → OLLAMA_BASE_URL OpenAI-compat).
  graphify_profile: ollama_gemma      # endpoint+key+model bundle 선택자. env 의 WIKIHUB_GRAPHIFY_<PROFILE_UPPER>_<ENDPOINT|API_KEY|MODEL> 와 1:1 매칭 (ADR-0038, v0.1.7 follow-up). 다중 profile 동시 보유 + yaml 한 줄 swap. 기본 ollama_gemma = local Ollama daemon + gemma4:31b-cloud. 추가 profile cookbook → docs/graphify-backend-test-reference.md §6.
  graphify_profiles:                  # (v0.1.10) profile-level timeout override. graphify_timeout_sec 보다 우선. 미설정 시 global → 900 fallback. Issue #36.
    ollama_gemma:
      timeout_sec: 1800               # ollama local LLM (gemma4:31b-cloud) — wiki 200+ 페이지 시 30분+ 소요. cloud profile 은 미설정 시 global 900s 사용.

# agent: Hermes (또는 codex/gemini) 는 install.sh 설치 범위 밖 — 메인테이너가 별도 설치 후 binary 경로 확인 필수.
# 미설치 시 install.sh _step6_agent_skill 가 detect → systemd unit render/enable skip (ADR-0032). 운영자가 hermes 설치 후 install.sh 재호출.
# 권장 검증: `command -v hermes` 가 binary path 와 일치하는지 /wh-setup Step 1 가 확인.
agent:
  type: hermes                                                            # ADR-0012 — 다른 값: codex, gemini
  binary: /usr/local/bin/hermes                                           # R10 MED-8: 미설치 시 운영자가 별도 설치 책임
  oneshot_args: ["chat", "--skills", "{skill}", "--quiet", "--yolo", "--query"]     # ADR-0032 + 2026-05-19 §Note — `{skill}` per-unit placeholder, `--quiet` transcript 차단, `--yolo` tirith auto-approve (noninteractive 환경 필수)
  skill_prefix: "wh-"                                                     # ADR-0033 (ADR-0011 supersedes — colon `wh:` → hyphen `wh-`)
  timeout_sec: 1200                                                       # bash timeout + systemd TimeoutStartSec sync source (ADR-0032 §sub-4). v0.1.5 default 600 → 1200 — DeepSeek 등 느린 LLM backend 대비 (Hermes 실증, 2026-05-20).
  models:                                                                 # ADR-0032 §Note (v0.1.5) — per-skill model override. 빈 dict 면 hermes config.yaml.model.default 사용. reasoning 모델 (deepseek-v4-*, glm-5.1, mimo-v2.5-pro) 은 max_tokens 부족 시 hang risk — non-reasoning (minimax-m2.5/2.7, kimi-k2.5/2.6, glm-5, qwen3.5/3.6-plus) 권장.
    wh-lint: deepseek-v4-flash                                            # non-reasoning fast-response (latency 2.6~6.4s/call, 260521 §B 측정 — v0.1.6 default minimax-m2.5 → deepseek-v4-flash). wh-ingest (`-pro`) 와 동일 DeepSeek 패밀리 + opencode-go backend 일관성. 한자→한글 출력 안정성은 lint.md "출력 언어 정책" 섹션이 model-agnostic 보호 layer 로 담당. minimax-m2.5 보수적 default 원할 시 운영자 override.
    wh-ingest: deepseek-v4-pro                                            # per-source LLM 호출 (entity/concept 추출) — reasoning 모델의 정확도 활용. 운영 후 max_tokens hang surface 시 `qwen3.6-plus` 로 fallback 권장 (non-reasoning + 한국어 안정).
    # wh-query/graphify/setup 미명시 → hermes default.
  notify_on_fatal: true                                                   # ADR-0024 — Hermes 통지 (v0.1.0 은 stub, v0.2.x 활성화)
